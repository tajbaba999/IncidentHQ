NODE_ENV=development
LOG_LEVEL=info
PORT=3000

DATABASE_URL=postgresql://pulseping:pulseping@localhost:5432/pulseping

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localhost:4566/000000000000

POSTGRES_USER=pulseping
POSTGRES_PASSWORD=pulseping
POSTGRES_DB=pulseping

CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# Optional: Clerk dashboard → Webhooks → Signing Secret (users are also created on first request without it)
CLERK_WEBHOOK_SECRET=

RESEND_API_KEY=re_xxx
# Optional: defaults to "PulsePing <onboarding@resend.dev>" (Resend test sender, only delivers to your own address)
RESEND_FROM_EMAIL=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# saas = Vercel + Neon, health checks via Vercel Cron sweep
# selfhost = Docker + standard Postgres, in-process scheduler
DEPLOY_MODE=saas
# Required in saas mode: protects GET /api/cron/health-check (Vercel Cron sends it as a Bearer token)
CRON_SECRET=change-me

CORS_ORIGIN=http://localhost:3001